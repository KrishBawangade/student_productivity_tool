# Google Gemini API Key template for Nexus Academia
# Copy this file to .env.local and insert your key from https://aistudio.google.com/
GEMINI_API_KEY=

# Neon PostgreSQL Database Credentials template for Nexus Academia
# Copy this file to .env.local and insert your connection URLs from https://neon.tech/
# 1. Pooled Connection URL (for serverless queries):
DATABASE_URL="postgresql://neondb_owner:your_password@ep-cool-cloud-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# 2. Direct Connection URL (for Prisma migrations):
DIRECT_URL="postgresql://neondb_owner:your_password@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

