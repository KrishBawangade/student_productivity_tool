# Nexus Academia Backend Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Database Connection (Neon / Postgres)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/nexus_academia?sslmode=require
DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/nexus_academia?sslmode=require

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here
